# === LIS-SKINS ===
# Chrome: lis-skins.com ga kiring -> F12 -> Network -> istalgan app.lis-skins.com so'rovi
# -> Headers -> Request Headers -> "cookie:" qatorini TO'LIQ nusxalang (XSRF-TOKEN ham bo'lishi shart)
LIS_COOKIE=

# Sotuvda sayt yuboradigan email (saytdagi bilan bir xil)
LIS_EMAIL=

# To'lov usuli (7 = siz saytda tanlagan usul)
PAYMENT_GROUP_ID=7
GAME=cs2
INSTANT_PAYOUT=1

# === Filtrlar ===
MIN_PRICE=0
MAX_PRICE=100
# nuqta-vergul bilan: INCLUDE=case;sticker   EXCLUDE=knife;gloves
INCLUDE=
EXCLUDE=
MAX_ITEMS_PER_OFFER=50

# === Ishlash rejimi ===
# DRY_RUN=1 -> hech narsa sotilmaydi, faqat ro'yxat ko'rsatiladi
DRY_RUN=1
LOOP=0
INTERVAL_SEC=300

# === Ixtiyoriy: Steam trade'ni avto-tasdiqlash ===
# Bu ma'lumotlar faqat sizning kompyuteringizda qolsin, hech kimga bermang!
STEAM_AUTO_CONFIRM=0
STEAM_API_KEY=
STEAM_LOGIN=
STEAM_PASSWORD=
# Steam Desktop Authenticator'ning .maFile fayliga yo'l
STEAM_MAFILE=

# === HTTP API (server.py) ===
# Istalgan uzun maxfiy so'z; saytingiz har so'rovda X-Api-Key sarlavhasida yuboradi
API_KEY=
PORT=8000
