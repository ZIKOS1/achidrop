{
    "framework": null,
    "buildCommand": "npm run build:frontend",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        { "source": "/api/:path*", "destination": "/api" },
        { "source": "/admin", "destination": "/admin.html" }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "node_modules/**",
            "maxDuration": 30
        }
    }
}
