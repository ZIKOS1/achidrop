{
    "framework": null,
    "buildCommand": "npm run build:frontend",
    "outputDirectory": "frontend/dist",
    "regions": [
        "arn1"
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api"
        },
        {
            "source": "/admin",
            "destination": "/admin.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "node_modules/**",
            "maxDuration": 30
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.achidrop.com"
                }
            ],
            "destination": "https://achidrop.com/:path*",
            "permanent": true
        }
    ]
}
