# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here
BOT_USERNAME=your_bot_username_without_at

# Mini App (HTTPS URL kerak — ngrok yoki hosting)
WEBAPP_URL=https://your-domain.com
WEBAPP_PORT=3000

# MongoDB Atlas connection string (Atlas dashboard > Connect > Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/auctionbot

# Steam inventar (real skin float integratsiyasi uchun)
# SteamID64'ni topish uchun: steamid.io ga profil linkingizni tashlang
# Profil > Maxfiylik sozlamalari > Inventar'ni Public qiling
# (Agar pastdagi STEAM_REFRESH_TOKEN sozlansa, bu shart emas — inventar
# private bo'lsa ham ishlaydi)
STEAM_ID64=your_steam_id64_here

# Steam Web API key ("Steam bilan kirish" tugmasi uchun) — bepul,
# https://steamcommunity.com/dev/apikey dan oling
STEAM_API_KEY=

# To'liq Steam sessiyasi (private inventar o'qish uchun) — QO'LDA YOZMANG,
# `node scripts/steam-login-setup.js` ishga tushirib, avtomatik to'ldiring.
# Bu token endi faqat LOKAL/VPS relay serverida kerak (Vercel'da emas) —
# Steam Community datacenter IP'larni (Vercel, AWS, GCP) bloklagani uchun
# inventar so'rovi alohida kichik VPS orqali yuboriladi.
STEAM_REFRESH_TOKEN=

# Steam inventar relay serveri (Vercel bloklanganda ishlatiladi) — pastdagi
# hujjatga qarang: bu kichik VPS (masalan Oracle Free Tier)da ishlaydigan
# alohida relay xizmatining manzili va maxfiy kaliti
STEAM_RELAY_URL=https://your-vps-ip:8443
STEAM_RELAY_SECRET=

# Lis-Skins API (Instant Sell + admin auto-list narxlarini olish uchun) —
# https://lis-skins.com da ro'yxatdan o'tib, API key oling
LIS_SKINS_API_KEY=

# To'lov kartalari
PAYME_CARD=8600 0000 0000 0000
CLICK_CARD=8600 0000 0000 0000
PAYNET_CARD=8600 0000 0000 0000
UZUM_CARD=8600 0000 0000 0000
CARD_OWNER=FAMILIYA ISM

# Faqat LOKAL RIVOJLANTIRISHDA (localhost) kerak — x-dev-uid orqali istalgan
# foydalanuvchi sifatida kirish uchun. PRODAKSHENDA HECH QACHON O'RNATMANG
# (bo'sh qoldiring/o'chiring) — bu bo'sh bo'lsa, dev-bypass umuman ishlamaydi.
NODE_ENV=development
DEV_BYPASS_SECRET=
